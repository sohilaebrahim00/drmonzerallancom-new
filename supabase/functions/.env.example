# Supabase Edge Function secrets — names only, no real values.
#
# These are NOT read by Vite and must NEVER be prefixed with VITE_ or placed
# in the project root .env files. Set them exclusively via:
#   supabase secrets set NAME=value
# or through the Supabase Dashboard (Project Settings > Edge Functions >
# Secrets). Never commit a real .env file here, never paste real values into
# chat, docs, or logs.

# Stripe (Dashboard > Developers > API keys / Webhooks / Products)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring membership prices (used by create-checkout-session)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_VIP=
# One-time Diet/Treatment program-package PRODUCT ids, not price ids — see
# supabase/functions/create-consultation-checkout-session (used by that
# function, which builds a one-time `price_data` line item on the fly).
STRIPE_PRODUCT_DIET_BASIC=
STRIPE_PRODUCT_DIET_PLUS=
STRIPE_PRODUCT_DIET_PREMIUM=
STRIPE_PRODUCT_TREATMENT_BASIC=
STRIPE_PRODUCT_TREATMENT_PLUS=
STRIPE_PRODUCT_TREATMENT_PREMIUM=

# Supabase (Project Settings > API) — SUPABASE_URL is injected automatically
# by the Edge Functions runtime; only the service role key must be set manually.
SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend — resend.com/api-keys)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=

# Public site URL, used to build links inside emails and Stripe redirect URLs.
SITE_URL=

# Gemini (Google AI Studio — aistudio.google.com/apikey). Powers the ai-chat
# Edge Function (AI Concierge). GEMINI_MODEL is optional — see
# supabase/functions/_shared/gemini.ts for the documented default used when
# it's unset. Never create a VITE_GEMINI_API_KEY equivalent — this key must
# only ever be read server-side.
GEMINI_API_KEY=
GEMINI_MODEL=

# Google Calendar + Google Meet (OAuth2 refresh-token flow). Powers the
# create-consultation Edge Function. Without these, bookings are safely
# reserved-then-rolled-back with an honest "not yet connected" message —
# no fake Meet link is ever generated. See
# supabase/functions/_shared/googleCalendar.ts for the exact flow.
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — from a Google Cloud OAuth
#     client (Calendar API enabled).
#   GOOGLE_REFRESH_TOKEN — obtained once by having the doctor authorize
#     that OAuth client with the calendar.events scope; long-lived.
#   GOOGLE_CALENDAR_ID — the doctor's calendar to write to (typically their
#     Google account email); also used as the "doctor" attendee address.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
