<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom-scheme deep link, e.g. monzerallan://consultations — handled in
                 src/components/native/DeepLinkHandler.tsx via the App plugin's appUrlOpen event. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="monzerallan" />
            </intent-filter>

            <!-- Universal/App Links for https://monzerallan.com/... — autoVerify requires
                 a real assetlinks.json hosted at https://monzerallan.com/.well-known/assetlinks.json
                 (with this app's release signing certificate fingerprint) before Android will
                 actually treat these as verified app links. Not hosted from this session — see
                 MOBILE_APP_IMPLEMENTATION_REPORT.md. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="monzerallan.com" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->
    <!-- Required in the app's own manifest even though the plugins declare
         them via @CapacitorPlugin annotations — Capacitor does not
         auto-inject these into AndroidManifest.xml (unlike local-notifications'
         POST_NOTIFICATIONS/RECEIVE_BOOT_COMPLETED, which ship their own
         manifest fragment and merge automatically). Each is requested at
         runtime only from its feature screen (Food Scanner / Prayer Times
         / Qibla) — never on app launch. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Food Scanner: "Take Photo" -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Food Scanner: "Choose From Gallery" on Android 12 and below (the
         modern system Photo Picker used on 13+ needs no permission at all). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Prayer Times / Qibla: calculating local times and the Qibla bearing.
         Coarse is sufficient for both — never requesting background location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
