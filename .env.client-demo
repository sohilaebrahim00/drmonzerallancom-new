# Loaded automatically by Vite when building with `--mode client-demo` (see
# package.json's build:demo script and vite.config.ts). Public, non-secret
# build-mode flag ONLY — selects the standalone client-preview UI (the
# /user and /doctor fixture experiences + chooser) instead of the marketing
# site or the real Web App. VITE_SUPABASE_URL/VITE_SUPABASE_PUBLISHABLE_KEY
# are deliberately left BLANK here (overriding whatever .env.local has) so
# this build has no way to reach the real Supabase project at all, even if
# a demo-mode guard were ever missed somewhere — src/lib/supabase.ts treats
# blank values as "not configured" and never creates a client. Real secrets
# never go in a VITE_* variable regardless of file — see .env.example.
VITE_APP_MODE=client-demo
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
