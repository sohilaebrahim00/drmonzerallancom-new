# Copy this file to .env.local and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle —
# never put private/secret keys here, only public identifiers and links.

# WhatsApp number in international format, digits only (no +, spaces, or dashes).
# Example: 15551234567
VITE_WHATSAPP_NUMBER=

# Google Calendar Appointment Schedule links (Calendar > Appointment schedules > Share/embed).
# Each schedule should be configured with Google Meet as the location and its own
# minimum-notice / buffer settings matching the package's booking rules.
VITE_GOOGLE_BOOKING_BASIC_URL=
VITE_GOOGLE_BOOKING_PREMIUM_URL=
VITE_GOOGLE_BOOKING_VIP_URL=

# Supabase project config (Project Settings > API). Both are public client
# identifiers — safe to expose in the browser bundle. NEVER put the
# service_role key, database password, or any other secret in a VITE_*
# variable; those are bundled into the public JS and visible to anyone.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
