# Copy this file to .env.local and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client bundle —
# never put private/secret keys here, only public identifiers and links.

# WhatsApp number in international format, digits only (no +, spaces, or dashes).
# Example: 15551234567
VITE_WHATSAPP_NUMBER=

# Google Calendar Appointment Schedule links (Calendar > Appointment schedules > Share/embed).
# Each schedule should be configured with Google Meet as the location and its own
# minimum-notice / buffer settings matching the package's booking rules.
VITE_GOOGLE_BOOKING_BASIC_URL=
VITE_GOOGLE_BOOKING_PREMIUM_URL=
VITE_GOOGLE_BOOKING_VIP_URL=

# Supabase project config (Project Settings > API). Both are public client
# identifiers — safe to expose in the browser bundle. NEVER put the
# service_role key, database password, or any other secret in a VITE_*
# variable; those are bundled into the public JS and visible to anyone.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe Publishable Key (Developers > API keys). Public by design — safe to
# expose in the browser bundle. NEVER put the Stripe Secret Key here or in
# any other VITE_* variable.
VITE_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Server-only secrets — DO NOT add these here. This file only documents
# their names for reference; real values belong exclusively in Supabase
# Edge Function secrets (`supabase secrets set NAME=value`), never in a
# VITE_* variable, never committed, never pasted into chat/docs/logs.
# See supabase/functions/.env.example for the full list.
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   STRIPE_PRICE_BASIC / STRIPE_PRICE_PREMIUM / STRIPE_PRICE_VIP
#   STRIPE_PRODUCT_SINGLE / STRIPE_PRODUCT_DOUBLE   (one-time consultation packages)
#   SUPABASE_SERVICE_ROLE_KEY
#   RESEND_API_KEY
#   EMAIL_FROM
#   ADMIN_NOTIFICATION_EMAIL
#   SITE_URL
#   GEMINI_API_KEY
#   GEMINI_MODEL
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN / GOOGLE_CALENDAR_ID
# Never create VITE_GEMINI_API_KEY or VITE_GOOGLE_CLIENT_SECRET-style
# variables — the AI Concierge and consultation booking are called
# exclusively through Supabase Edge Functions, never directly from the browser.
