{
  "name": "monzerallancom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --mode app",
    "build": "vite build",
    "build:web": "npm run prices:check && vite build",
    "build:app": "vite build --mode app && node scripts/write-app-htaccess.cjs",
    "build:demo": "vite build --mode client-demo && node scripts/write-client-demo-assets.cjs",
    "preview": "vite preview",
    "preview:app": "vite preview --mode app",
    "preview:demo": "vite preview --mode client-demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prices:emit": "node scripts/emit-price-manifest.mjs",
    "i18n:review": "node scripts/build-translation-review.mjs",
    "prices:check": "node scripts/emit-price-manifest.mjs --check",
    "build:knowledge": "tsx scripts/build-ai-knowledge.ts",
    "build:pwa-icons": "node scripts/build-pwa-icons.cjs",
    "build:website-favicons": "node scripts/build-website-favicons.cjs",
    "cap:sync": "npm run build && npx cap sync && node scripts/fix-ios-package-swift.cjs",
    "cap:sync:ios": "npm run build && npx cap sync ios && node scripts/fix-ios-package-swift.cjs",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "cap:ios": "npm run cap:sync:ios && npx cap open ios",
    "cap:assets": "npx capacitor-assets generate",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "gate": "npm run typecheck && npm run check:functions && npm run check:knowledge && npm run check:retrieval && npm run check:functions:cors && npm run lint && npm run build:web && npm run build:app && npm run i18n:audit",
    "i18n:audit:setup": "playwright install chromium",
    "check:functions": "node scripts/check-functions.mjs",
    "check:functions:cors": "node scripts/check-function-cors.mjs",
    "check:knowledge": "tsx scripts/check-knowledge.ts",
    "check:retrieval": "npx --yes deno@latest run --allow-read scripts/retrieval-selftest.ts"
  },
  "dependencies": {
